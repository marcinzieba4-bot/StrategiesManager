# ─────────────────────────────────────────────────────────
#  Telegram Lambda Agent — Environment Variables
#  Copy to .env and fill in your real values.
#  NEVER commit the populated .env to source control.
# ─────────────────────────────────────────────────────────

# ── Anthropic / Claude ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use. claude-opus-4-6 is the default (most capable).
# Other options: claude-sonnet-4-6, claude-haiku-4-5
CLAUDE_MODEL=claude-opus-4-6

# Maximum tokens Claude may produce per reply
MAX_TOKENS=4096

# Optional custom system prompt shown to Claude on every request.
# Leave empty to use the built-in default.
AGENT_SYSTEM_PROMPT=

# ── Telegram ────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Comma-separated Telegram user/chat IDs allowed to use the bot.
# Find yours: message @userinfobot or check your Telegram user ID.
# Leave empty to allow all (not recommended).
TELEGRAM_ALLOWED_CHAT_IDS=7366508056

# Optional: a random secret string (≤256 alphanumeric + _- chars).
# If set, the Lambda verifies every incoming webhook request carries
# the matching X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# ── AWS / S3 ────────────────────────────────────────────
# Bucket that holds context / knowledge files for the agent
S3_BUCKET_NAME=my-strategies-bucket

# Key prefix (folder) where context files live.
# The agent will list and read files under this prefix.
S3_CONTEXT_PREFIX=context/

# Additional prefix for strategy-specific docs (optional)
S3_STRATEGIES_PREFIX=strategies/

# AWS region for S3 and Lambda (Lambda sets AWS_REGION automatically)
AWS_REGION=us-east-1

# ── Lambda-to-Lambda invocation ─────────────────────────
# Region for invoking other Lambda functions (defaults to AWS_REGION)
LAMBDA_INVOKE_REGION=us-east-1

# Comma-separated allow-list of Lambda function names the agent may trigger.
# Leave empty to allow any function name (not recommended for production).
LAMBDA_ALLOWED_FUNCTIONS=my-strategy-runner,my-data-fetcher

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
